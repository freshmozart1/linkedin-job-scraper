{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    // The base config sets rootDir to "src" so the build emits dist/*.js flat.
    // This program also includes test/**, which sits outside that root, so widen
    // it — harmless here because noEmit means rootDir affects nothing else.
    "rootDir": "."
  },
  "include": [
    "test/**/*.ts",
    "src/**/*.ts",
    // Debugging scripts run through tsx, never built. They belong here so
    // `npm run typecheck` covers them, and deliberately NOT in tsconfig.json,
    // whose program is what `npm run build` emits into the published dist/.
    "scripts/**/*.ts"
  ]
}